{
  "name": "project-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"PROJECT_HUB_DEV_ORIGIN=http://127.0.0.1:5173 node --watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "sample": "node scripts/sample.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "agent:install": "node scripts/launch-agent.ts install",
    "agent:uninstall": "node scripts/launch-agent.ts uninstall",
    "agent:status": "node scripts/launch-agent.ts status",
    "hooks:plan": "node scripts/install-hooks.ts",
    "hooks:backup": "node scripts/install-hooks.ts backup",
    "hooks:install": "node scripts/install-hooks.ts apply",
    "hooks:uninstall": "node scripts/install-hooks.ts uninstall",
    "mcp": "node --disable-warning=ExperimentalWarning scripts/mcp.ts",
    "mcp:plan": "node scripts/install-mcp.ts plan",
    "mcp:install": "node scripts/install-mcp.ts apply",
    "mcp:uninstall": "node scripts/install-mcp.ts uninstall"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.299",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tanstack/react-query": "^5.104.2",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "cmdk": "1.1.1",
    "drizzle-orm": "^0.45.4",
    "execa": "^10.1.1",
    "hono": "^4.13.13",
    "lucide-react": "1.59.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-git": "^4.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}

{
  "manifest_version": 3,
  "name": "Project Hub",
  "version": "0.1.0",
  "description": "Tells your local Project Hub (127.0.0.1:4747) which claude.ai chat you have open, and adds the current tab to a project.",
  "key": "",
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:4747/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["chat-page.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Add this tab to a project", "default_popup": "popup.html" }
}
